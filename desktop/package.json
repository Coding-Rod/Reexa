{
  "name": "reexa-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Reexa desktop: online app, or local mode with Ollama models",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "local": "REEXA_MODE=local electron .",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:win": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.reexa.desktop",
    "productName": "Reexa",
    "files": [
      "main.js",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    },
    "artifactName": "Reexa-${version}-${os}-${arch}.${ext}"
  }
}
